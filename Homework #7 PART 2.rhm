#lang shplait

type Value
| intV(n :: Int)
| closV(args :: Listof(Symbol),
        body :: Exp,
        env :: Env)
| contV(k :: Cont)

| errorV(s :: String)

type Exp
| intE(n :: Int)
| idE(s :: Symbol)
| plusE(l :: Exp,
        r :: Exp)
| multE(l :: Exp,
        r :: Exp)
| funE(args :: Listof(Symbol),
       body :: Exp)
| appE(fn :: Exp,
       args :: Listof(Exp))
| letccE(n :: Symbol,
         body :: Exp)
| negE(e :: Exp)
| avgE(e1 :: Exp, e2 :: Exp, e3 :: Exp)
| ifE(condition :: Exp, then :: Exp, else :: Exp)
| tryE(body :: Exp,
       handle :: Exp)

type Binding
| bind(name :: Symbol,
       val :: Value)

type Env = Listof(Binding)

def mt_env = []
def extend_env = cons

type Cont
| doneK()
| plusSecondK(r :: Exp,
              e :: Env,
              k :: Cont)
| doPlusK(v :: Value,
          k :: Cont)
| multSecondK(r :: Exp,
              e :: Env,
              k :: Cont)
| doMultK(v :: Value,
          k :: Cont)
| appArgsK(as :: Listof(Exp),
           env :: Env,
           k :: Cont)
| appK(f :: Value,
       vs :: Listof(Value),
       as :: Listof(Exp),
       env :: Env,
       k :: Cont)

| negK(k :: Cont)
| avgFirstK(e2 :: Exp, e3 :: Exp, env :: Env, k :: Cont)
| avgSecondK(v1 :: Value, e3 :: Exp, env :: Env, k :: Cont)
| avgThirdK(v1 :: Value, v2 :: Value, k :: Cont)
| ifK(then :: Exp, else :: Exp, env :: Env, k :: Cont)

| tryK(handle :: Exp,
       env :: Env,
       k :: Cont)

// parse ----------------------------------------
fun parse(s :: Syntax) :: Exp:
  cond
  | syntax_is_integer(s):
      intE(syntax_to_integer(s))
  | syntax_is_symbol(s):
      idE(syntax_to_symbol(s))
  | ~else:
      match s
      | 'try:
           $body
           ~catch: $handle':
          tryE(parse(body),
               parse(handle))
      | 'let_cc $name:
           $body':
          letccE(syntax_to_symbol(name),
                 parse(body))
      | 'let $name = $rhs:
           $body':
          appE(funE([syntax_to_symbol(name)],
                    parse(body)),
               [parse(rhs)])
      | '$left + $right':
          plusE(parse(left),
                parse(right))
      | '$left * $right':
          multE(parse(left),
                parse(right))
      | 'fun ($id, ...): $body':
          funE(map(syntax_to_symbol, syntax_to_list('[$id, ...]')),
               parse(body))
      | 'neg($e)':
          negE(parse(e))
      | 'avg($e1, $e2, $e3)':
          avgE(parse(e1), parse(e2), parse(e3))

      #//
      | 'fun ($id): $body':
          funE([syntax_to_symbol(id)],
               parse(body))
      | '$fn($arg, ...)':
          appE(parse(fn),
               map(parse, syntax_to_list('[$arg, ...]')))
      | '($e)':
          parse(e)

      | 'if $condition == 0 | $then | $else':
          ifE(parse(condition), parse(then), parse(else))
      | ~else:
          error(#'parse, "invalid input: " +& s)

module test:
  check: parse('2')
         ~is intE(2)
  check: parse('x')
         ~is idE(#'x)
  check: parse('2 + 1')
         ~is plusE(intE(2), intE (1))
  check: parse('3 * 4')
         ~is multE(intE(3), intE(4))
  check: parse('3 * 4 + 8')
         ~is plusE(multE(intE(3), intE(4)),
                   intE(8))
  check: parse('fun (x): 9')
         ~is funE([#'x], intE(9))
  check: parse('double(9)')
         ~is appE(idE(#'double), [intE(9)])
  check: parse('1 + double(9)')
         ~is plusE(intE(1),
                   appE(idE(#'double), [intE(9)]))
  check: parse('3 * (4 + 8)')
         ~is multE(intE(3),
                   plusE(intE(4), intE(8)))
  check: parse('let x = 1 + 2:
                  y')
         ~is appE(funE([#'x],
                       idE(#'y)),
                  [plusE(intE(1), intE(2))])
  check: parse('let_cc k: 0')
         ~is letccE(#'k, intE(0))
  check: parse('1 2')
         ~raises "invalid input"




// interp_expr ----------------------------------------
fun interp_expr(e :: Exp) :: Syntax:
  match interp(e, mt_env, doneK())
  | intV(n): integer_to_syntax(n)
  | closV(arg, body, env): 'function'
  | contV(k): 'function'
  | errorV(s): string_to_syntax(s)



// interp ----------------------------------------
fun interp(a :: Exp, env :: Env, k :: Cont) :: Value:
  match a
  | intE(n): continue(k, intV(n))
  | idE(s): continue(k, lookup(s, env))
  | plusE(l, r): interp(l, env,
                        plusSecondK(r, env, k))
  | multE(l, r): interp(l, env,
                        multSecondK(r, env, k))
  | funE(ns, body): continue(k, closV(ns, body, env))
  | appE(fn, args): interp(fn, env, appArgsK(args, env, k))
  | letccE(n, body):
      interp(body,
             extend_env(bind(n, contV(k)),
                        env),
             k)

  | negE(e): interp(e, env, negK(k))
  | avgE(e1, e2, e3): interp(e1, env, avgFirstK(e2, e3, env, k))
  | ifE(condition, then, else): interp(condition, env, ifK(then, else, env, k))

  | tryE(body, handler):
      interp(body, env, tryK(handler, env, k))


fun extend_env_list(env :: Env, names :: Listof(Symbol), vals :: Listof(Value)) :: Env:
  match names
  | []: 
      match vals
      | []: env
      | ~else: error(#'extend_env_list, "mismatched names and values")
  | cons(name, rest_names):
      match vals
      | cons(val, rest_vals):
          extend_env_list(extend_env(bind(name, val), env),
                          rest_names,
                          rest_vals)
      | ~else:
          error(#'extend_env_list, "mismatched names and values")



fun continue(k :: Cont, v :: Value) :: Value:
  match v
  | errorV(s): escape(k, v)
  | ~else:
      match k
      | doneK(): v
      | plusSecondK(r, env, next_k):
          interp(r, env,
                 doPlusK(v, next_k))
      | doPlusK(v_l, next_k):
          continue(next_k, num_plus(v_l, v))
      | multSecondK(r, env, next_k):
          interp(r, env,
                 doMultK(v, next_k))
      | doMultK(v_l, next_k):
          continue(next_k, num_mult(v_l, v))
      | appArgsK(args, env, next_k):
          match args
          | []:
              match v
              | closV(params, body, c_env):
                  cond
                  | length(params) == 0: interp(body, c_env, next_k)
                  | ~else:
                      error(#'interp, "wrong number of arguments")
              | contV(_):
                  error(#'interp, "continuation expects exactly one argument")
              | ~else:
                  error(#'interp, "not a function")
          | cons(first_arg, rest_args):
              interp(first_arg, env, appK(v, [], rest_args, env, next_k))
      | appK(f, vs, as, env, next_k):
          match as
          | []:
              match f
              | closV(params, body, c_env):
                  cond
                  | length(params) == length(cons(v, vs)):
                      def args = reverse(cons(v, vs))
                      interp(body,
                             extend_env_list(c_env, params, args),
                             next_k)
                  | ~else:
                      error(#'interp, "wrong number of arguments")
              | contV(k_v):
                  cond
                  | length(vs) == 0:
                      continue(k_v, v)
                  | ~else:
                      error(#'interp, "continuation expects exactly one argument")
              | ~else:
                  error(#'interp, "not a function")
          | cons(next_arg, rest_args):
              interp(next_arg, env, appK(f, cons(v, vs), rest_args, env, next_k))

      | negK(next_k):
          continue(next_k, num_neg(v))
      | avgFirstK(e2, e3, env, next_k):
          interp(e2, env, avgSecondK(v, e3, env, next_k))
      | avgSecondK(v1, e3, env, next_k):
          interp(e3, env, avgThirdK(v1, v, next_k))
      | avgThirdK(v1, v2, next_k):
          continue(next_k, num_avg(v1, v2, v))
      | ifK(then, else, env, next_k):
          interp(if intV.n(v) == 0 | then | else, env, next_k)

      | tryK(h, env, next_k):
         continue(next_k, v)



module test:
  check: interp(parse('2'), mt_env, doneK())
         ~is intV(2)
  check: interp(parse('x'), mt_env, doneK())
         ~raises "free variable"
  check: interp(parse('x'),
                extend_env(bind(#'x, intV(9)), mt_env),
                doneK())
         ~is intV(9)
  check: interp(parse('2 + 1'), mt_env, doneK())
         ~is intV(3)
  check: interp(parse('2 * 1'), mt_env, doneK())
         ~is intV(2)
  check: interp(parse('(2 * 3) + (5 + 8)'), mt_env, doneK())
         ~is intV(19)
  check: interp(parse('fun (x): x + x'),
                mt_env,
                doneK())
         ~is closV([#'x], plusE(idE(#'x), idE(#'x)), mt_env)
  check: interp(parse('let x = 5: x + x'),
                mt_env,
                doneK())
         ~is intV(10)
  check: interp(parse('let x = 5:
                         let x = x + 1:
                           x + x'),
                mt_env,
                doneK())
         ~is intV(12)
  check: interp(parse('let x = 5:
                         let y = 6:
                           x'),
                mt_env,
                doneK())
         ~is intV(5)
  check: interp(parse('(fun (x): x + x)(8)'),
                mt_env,
                doneK())
         ~is intV(16)
  check: interp(parse('1(2)'), mt_env, doneK())
         ~raises "not a function"
  check: interp(parse('1 + (fun (x): x)'), mt_env, doneK())
         ~is errorV("not a number")
  check: interp(parse('let bad = (fun (x): x + y):
                         let y = 5:
                           bad(2)'),
                mt_env,
                doneK())
         ~raises "free variable"

  check: interp(parse('let_cc k: 1 + k(0)'),
                mt_env,
                doneK())
         ~is intV(0)
  check: interp(parse('let f = (let_cc k: k):
                         f(fun (x): 10)'),
                mt_env,
                doneK())
         ~is intV(10)

  // Eager:
  check: interp(parse('(fun (x): 0)(1(2))'), mt_env, doneK())
         ~raises "not a function"

  check: continue(doneK(), intV(5))
         ~is intV(5)
  check: continue(plusSecondK(intE(6), mt_env, doneK()), intV(5))
         ~is intV(11)
  check: continue(doPlusK(intV(7), doneK()), intV(5))
         ~is intV(12)
  check: continue(multSecondK(intE(6), mt_env, doneK()), intV(5))
         ~is intV(30)
  check: continue(doMultK(intV(7), doneK()), intV(5))
         ~is intV(35)
  #//
  check: continue(appArgK(intE(5), mt_env, doneK()), closV([#'x], idE(#'x), mt_env))
         ~is intV(5)

  #//
  check: continue(doAppK(closV([#'x], idE(#'x), mt_env), doneK()), intV(8))
         ~is intV(8)
                       
// num_plus and num_mult ----------------------------------------
fun num_op(op :: (Int, Int) -> Int, l :: Value, r :: Value) :: Value:
  cond
  | l is_a intV && r is_a intV:
      intV(op(intV.n(l), intV.n(r)))
  | ~else:
      errorV("not a number")
fun num_plus(l :: Value, r :: Value) :: Value:
  num_op(fun (a, b): a+b, l, r)
fun num_mult(l :: Value, r :: Value) :: Value:
  num_op(fun (a, b): a*b, l, r)

module test:
  check: num_plus(intV(1), intV(2))
         ~is intV(3)
  check: num_mult(intV(3), intV(2))
         ~is intV(6)

// Helper functions for new operations
fun num_neg(v :: Value) :: Value:
  match v
  | intV(n): intV(0 - n)
  | ~else: errorV("not a number")

fun num_avg(v1 :: Value, v2 :: Value, v3 :: Value) :: Value:
  cond
  | v1 is_a intV && v2 is_a intV && v3 is_a intV:
      intV((intV.n(v1) + intV.n(v2) + intV.n(v3)) / 3)
  | ~else:
      errorV("not a number")


// lookup ----------------------------------------
fun lookup(n :: Symbol, env :: Env) :: Value:
  match env
  | []: error(#'lookup, "free variable: " +& n)
  | cons(b, rst_env):
      cond
      | n == bind.name(b):
          bind.val(b)
      | ~else:
          lookup(n, rst_env)

module test:
  check: lookup(#'x, mt_env)
         ~raises "free variable"
  check: lookup(#'x, extend_env(bind(#'x, intV(8)), mt_env))
         ~is intV(8)
  check: lookup(#'x, extend_env(bind(#'x, intV(9)),
                                extend_env(bind(#'x, intV(8)),
                                           mt_env)))
         ~is intV(9)
  check: lookup(#'y, extend_env(bind(#'x, intV(9)),
                                extend_env(bind(#'y, intV(8)),
                                           mt_env)))
         ~is intV(8)

fun escape(k :: Cont, v :: Value) :: Value:
  match k
  | doneK(): v
  | plusSecondK(r, env, next_k): escape(next_k, v)
  | doPlusK(v_l, next_k): escape(next_k, v)
  | multSecondK(r, env, next_k): escape(next_k, v)
  | doMultK(v_l, next_k): escape(next_k, v)
  | appArgsK(a, env, next_k): escape(next_k, v)
  | appK(v_f, vs, as, env, next_k): escape(next_k, v)
  | negK(next_k): escape(next_k, v)
  | avgFirstK(e2, e3, env, next_k): escape(next_k, v)
  | avgSecondK(v1, e3, env, next_k): escape(next_k, v)
  | avgThirdK(v1, v2, next_k): escape(next_k, v)
  | ifK(then, else, env, next_k): escape(next_k, v)
  | tryK(h, env, next_k): interp(h, env, next_k)

module test:
  check: escape(doneK(), intV(1))
         ~is intV(1)
  check: escape(plusSecondK(intE(2), mt_env, doneK()), intV(1))
         ~is intV(1)
  check: escape(doPlusK(intV(2), doneK()), intV(1))
         ~is intV(1)
  check: escape(multSecondK(intE(2), mt_env, doneK()), intV(1))
         ~is intV(1)
  check: escape(doMultK(intV(1), doneK()), intV(1))
         ~is intV(1)

  #//
  check: escape(appArgsK(intE(0), mt_env, doneK()), intV(1))
         ~is intV(1)

  #//
  check: escape(doAppK(intV(0), doneK()), intV(1))
         ~is intV(1)
  check: escape(tryK(intE(8), mt_env, doneK()), intV(0))
         ~is intV(8)

  check: escape(doPlusK(intV(3), doneK()), errorV("fail"))
         ~is errorV("fail")

  check: escape(doPlusK(intV(1),
                        tryK(intE(2), mt_env,
                             doneK())),
                errorV("fail"))
         ~is intV(2)

  check: escape(doPlusK(intV(1),
                        tryK(intE(2), mt_env,
                             doPlusK(intV(3),
                                     doneK()))),
                errorV("fail"))
         ~is intV(5)

module test:
  // Test escape with different continuations
  check: escape(negK(doneK()), intV(1))
         ~is intV(1)

  check: escape(avgFirstK(intE(2), intE(3), mt_env, doneK()), intV(1))
         ~is intV(1)

  check: escape(avgSecondK(intV(1), intE(3), mt_env, doneK()), intV(2))
         ~is intV(2)

  check: escape(avgThirdK(intV(1), intV(2), doneK()), intV(3))
         ~is intV(3)

  check: escape(ifK(intE(1), intE(2), mt_env, doneK()), intV(0))
         ~is intV(0)

  check: escape(appArgsK([intE(1), intE(2)], mt_env, doneK()), intV(0))
         ~is intV(0)

  check: escape(appK(closV([#'x], intE(0), mt_env),
                     [intV(1)],
                     [intE(2)],
                     mt_env,
                     doneK()),
                intV(0))
         ~is intV(0)

  check: interp_expr(parse('let_cc k:
                             neg(k(5))'))
         ~is '5'

  check: interp_expr(parse('let_cc k:
                             avg(k(5), 1, 2)'))
         ~is '5'

  check: interp_expr(parse('let_cc k:
                             avg(1, k(5), 2)'))
         ~is '5'

  check: interp_expr(parse('let_cc k:
                             avg(1, 2, k(5))'))
         ~is '5'

  check: interp_expr(parse('let_cc k:
                             if k(5) == 0 | 1 | 2'))
         ~is '5'

  check: interp_expr(parse('let_cc k:
                             (fun (x): x)(k(5))'))
         ~is '5'

  check: interp_expr(parse('let_cc k:
                             (fun (x, y): x)(1, k(5))'))
         ~is '5'

  // PART 1
  check: interp_expr(parse('neg(2)'))
         ~is '-2'
  check: interp_expr(parse('avg(0, 6, 6)'))
         ~is '4'
  check: interp_expr(parse('let_cc k: neg(k(3))'))
         ~is '3'
  check: interp_expr(parse('let_cc k: avg(0, k(3), 0)'))
         ~is '3'
  check: interp_expr(parse('let_cc k: avg(k(2), k(3), 0)'))
         ~is '2'
  check: interp_expr(parse('if 1 == 0 | 2 | 3'))
         ~is '3'
  check: interp_expr(parse('if 0 == 0 | 2 | 3'))
         ~is '2'
  check: interp_expr(parse('let_cc k: if k(9) == 0 | 2 | 3'))
         ~is '9'
  // PART 2
  check: interp_expr(parse('(fun(x, y): y + neg(x))(10, 12)'))
         ~is '2'
  check: interp_expr(parse('fun (): 12'))
         ~is 'function'
  check: interp_expr(parse('fun (x): fun (): x'))
         ~is 'function'
  check: interp_expr(parse('(fun (x): fun (): x)(13)()'))
         ~is '13'

  check: interp_expr(parse('let_cc esc: (fun (x, y): x)(1, esc(3))'))
         ~is '3'
  check: interp_expr(parse('let f = (fun (x, y): fun (z): z + y):
                              (let_cc esc: f(1, let_cc k: esc(k)))(10)'))
         ~is '20'

  check: interp_expr(parse('(fun (x, y): 1)(1, 2, 3)'))
         // error because function is given too many arguments,
         // but the specific error message is not specified
         ~raises ""
  check: interp_expr(parse('let_cc esc: esc()'))
         // error because continuation is given 0 arguments
         ~raises ""
  check: interp_expr(parse('let_cc esc: esc(1, 2)'))
         // error because continuation is given 2 arguments
         ~raises ""

  // test num_neg
  check: interp_expr(parse('neg(fun (x): x)'))
         ~is '"not a number"'

  // test num_avg
  check: interp_expr(parse('avg(fun (x): x, 1, 1)'))  // the first arg is not a number
         ~is '"not a number"'
  check: interp_expr(parse('avg(1, fun (x): x, 1)'))  // the second arg is not a number
         ~is '"not a number"'
  check: interp_expr(parse('avg(1, 1, fun (x): x)'))  // the third arg is not a number
         ~is '"not a number"'

  // test extend_env_list
  // test case 1:
  check: extend_env_list(mt_env, [], [intV(1)])
         ~raises "mismatched names and values"
  // test case 2:
  check: extend_env_list(mt_env, 
                         [#'x, #'y],
                         [intV(1)])
         ~raises "mismatched names and values"
  check: interp_expr(parse('(fun (x, y): 1)(1)'))
         ~raises "wrong number of arguments"
  check: interp_expr(parse('(fun (): 1)(1)'))
         ~raises "wrong number of arguments"

  // test appArgsK
  check: interp_expr(parse('1()'))
         ~raises "not a function"
  check: interp_expr(parse('let_cc k: k()'))  
         ~raises "continuation expects exactly one argument"
  check: interp_expr(parse('(fun (x): x)()'))
         ~raises "wrong number of arguments"
  check: interp_expr(parse('(fun (x, y): x + y)()'))
         ~raises "wrong number of arguments"

  check: interp_expr(parse('let_cc k: k'))
         ~is 'function'

  check: parse('try:
                  1 + 2
                  ~catch: 8')
         ~is tryE(plusE(intE(1), intE(2)), intE(8))

module test:

  // test try-catch
  check: interp_expr(parse('try:
                             42
                             ~catch: 0'))
         ~is '42'
  check: interp_expr(parse('try:
                             let_cc k:
                               1 + k(42)
                             ~catch: 0'))
         ~is '42'
  check: interp_expr(parse('try:
                             123
                             ~catch: 456'))
         ~is '123'
         