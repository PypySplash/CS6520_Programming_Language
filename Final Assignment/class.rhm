#lang shplait

type Exp
| intE(n :: Int)
| plusE(lhs :: Exp,
        rhs :: Exp)
| multE(lhs :: Exp,
        rhs :: Exp)
| argE()
| thisE()
| newE(class_name :: Symbol,
       args :: Listof(Exp))
| getE(obj_exp :: Exp,
       field_name :: Symbol)
| sendE(obj_exp :: Exp,
        method_name :: Symbol,
        arg_exp :: Exp)
| ssendE(obj_exp :: Exp,
         class_name :: Symbol,
         method_name :: Symbol,
         arg_exp :: Exp)
// 3.
| ifzeroE(test :: Exp,
          then :: Exp,
          else :: Exp)
// 5.
| letE(name :: Symbol,
       rhs :: Exp,
       body :: Exp)
| idE(name :: Symbol)
// 8.
| nullE()
// 1.
| castE(target_type :: Symbol,
        exp :: Exp)

type Class
| classC(field_names :: Listof(Symbol),
         methods :: Listof(Symbol * Exp))

type Value
| intV(n :: Int)
| objV(class_name :: Symbol,
       fields :: Listof(Value))
// 8.
| nullV()

// ----------------------------------------

fun find(l :: Listof(Symbol * ?a), name :: Symbol) :: ?a:
  match l
  | []:
      error(#'find, "not found: " +& name)
  | cons(p, rst_l):
      if fst(p) == name
      | snd(p)
      | find(rst_l, name)

module test:
  check: find([values(#'a, 1)], #'a)
         ~is 1
  check: find([values(#'a, "apple")], #'a)
         ~is "apple"
  check: find([values(#'a, 1), values(#'b, 2)], #'b)
         ~is 2
  check: find([], #'a)
         ~raises "not found: a"
  check: find([values(#'a, 1)], #'x)
         ~raises "not found: x"




fun check_class_ancestor(class_name :: Symbol, 
                         ancestor_name :: Symbol,
                         classes :: Listof(Symbol * Class)) :: Boolean:
  if class_name == ancestor_name
  | #true
  | block:
      try:
        match find(classes, class_name)
        | classC(field_names, methods):
            match find(classes, ancestor_name)
            | classC(ancestor_fields, ancestor_methods):
                subset(field_names, ancestor_fields)
        ~catch:
          #false

fun subset(list1 :: Listof(Symbol), list2 :: Listof(Symbol)) :: Boolean:
  match list1
  | []: #true
  | cons(fst, rst):
      if member(fst, list2)
      | subset(rst, list2)
      | #false

fun member(item :: Symbol, lst :: Listof(Symbol)) :: Boolean:
  match lst
  | []: #false
  | cons(fst, rst):
      if fst == item
      | #true
      | member(item, rst)
        
// ----------------------------------------
        
def interp :: (Exp, Listof(Symbol * Class), Value, Value, Listof(Symbol * Value)) -> Value:
  fun (a, classes, this_val, arg_val, env):
    fun recur(exp):
      interp(exp, classes, this_val, arg_val, env)
    match a
    // 8.
    | nullE(): nullV()
    | intE(n): intV(n)
    | plusE(l, r): num_plus(recur(l), recur(r))
    | multE(l, r): num_mult(recur(l), recur(r))
    | thisE(): this_val
    | argE(): arg_val
    | newE(class_name, field_exps):
        def c = find(classes, class_name)
        def vals = map(recur, field_exps)
        if length(vals) == length(classC.field_names(c))
        | objV(class_name, vals)
        | error(#'interp, "wrong field count")
    | getE(obj_exp, field_name):
        match recur(obj_exp)
        | objV(class_name, fields):
            match find(classes, class_name)
            | classC(field_names, methods):
                find(map2(fun (n, v): values(n, v), field_names, fields),
                     field_name)
        | ~else:
            error(#'interp, "not an object")
    | sendE(obj_exp, method_name, arg_exp):
        def obj = recur(obj_exp)
        def arg_val = recur(arg_exp)
        match obj
        | objV(class_name, fields):
            call_method(class_name, method_name, classes, obj, arg_val)
        | ~else:
            error(#'interp, "not an object")
    | ssendE(obj_exp, class_name, method_name, arg_exp):
        def obj = recur(obj_exp)
        def arg_val = recur(arg_exp)
        call_method(class_name, method_name, classes, obj, arg_val)
    // 3.
    | ifzeroE(test, then, else):
        match recur(test)
        | intV(n):
            cond
            | n == 0:
                recur(then)
            | ~else:
                recur(else)
        | ~else:
            error(#'interp, "condition must be number")
    // 5.
    | letE(name, rhs, body):
        def rhs_val = recur(rhs)
        interp(body, classes, this_val, arg_val,
               cons(values(name, rhs_val), env))
    | idE(name):
        try:
          find(env, name)
          ~catch:
            error(#'interp, "unbound identifier: " +& name)
    // 1.
    | castE(target_type, exp):
        def val = recur(exp)
        match val
        | objV(class_name, fields):
            if check_class_ancestor(class_name, target_type, classes)
            | val 
            | error(#'interp, "cast failed: " +& class_name +& " is not a " +& target_type)
        | nullV():
            nullV()  // null can be cast to any object type
        | ~else:
            error(#'interp, "can only cast objects")


fun call_method(class_name, method_name, classes, obj, arg_val):
  match find(classes, class_name)
  | classC(field_names, methods):              
      let body_exp = find(methods, method_name):
        interp(body_exp, classes, obj, arg_val, [])
                      
fun num_op(op :: (Int, Int) -> Int, l :: Value, r :: Value) :: Value:
  cond
  | l is_a intV && r is_a intV:
      intV(op(intV.n(l), intV.n(r)))
  | ~else:
      error(#'interp, "not a number")
fun num_plus(l :: Value, r :: Value) :: Value:
  num_op(fun (a, b): a+b, l, r)
fun num_mult(l :: Value, r :: Value) :: Value:
  num_op(fun (a, b): a*b, l, r)

// ----------------------------------------
// Examples

module test:
  def posn_class:
    values(
      #'Posn,
      classC([#'x,#'y],
             [
               values(#'mdist,
                      plusE(getE(thisE(), #'x), getE(thisE(), #'y))),
               values(#'addDist,
                      plusE(sendE(thisE(), #'mdist, intE(0)),
                            sendE(argE(), #'mdist, intE(0)))),
               values(#'addX,
                      plusE(getE(thisE(), #'x), argE())),
               values(#'multY,
                      multE(argE(), getE(thisE(), #'y))),
               values(#'factory12,
                      newE(#'Posn, [intE(1), intE(2)]))
             ])
      )

  def posn3D_class:
    values(
      #'Posn3D,
      classC([#'x,#'y, #'z],
             [
               values(#'mdist,
                      plusE(getE(thisE(), #'z),
                            ssendE(thisE(), #'Posn, #'mdist, argE()))),
               values(#'addDist,
                      ssendE(thisE(), #'Posn, #'addDist, argE()))
             ])
    )

  def posn27 = newE(#'Posn, [intE(2), intE(7)])
  def posn531 = newE(#'Posn3D, [intE(5), intE(3), intE(1)])
  fun interp_posn(a):
    interp(a, [posn_class, posn3D_class], intV(-1), intV(-1), [])

// ----------------------------------------

module test:
  check: interp(intE(10),
                [], objV(#'Object, []), intV(0), [])
         ~is intV(10)
  check: interp(plusE(intE(10), intE(17)),
                [], objV(#'Object, []), intV(0), [])
         ~is intV(27)
  check: interp(multE(intE(10), intE(7)),
                [], objV(#'Object, []), intV(0), [])
         ~is intV(70)
  check: interp_posn(newE(#'Posn, [intE(2), intE(7)]))
         ~is objV(#'Posn, [intV(2), intV(7)])
  
  check: interp_posn(sendE(posn27, #'mdist, intE(0)))
         ~is intV(9)
  
  check: interp_posn(sendE(posn27, #'addX, intE(10)))
         ~is intV(12)

  check: interp_posn(sendE(ssendE(posn27, #'Posn, #'factory12, intE(0)),
                           #'multY,
                           intE(15)))
         ~is intV(30)
  check: interp_posn(sendE(posn531, #'addDist, posn27))
         ~is intV(18)
  
  check: interp_posn(plusE(intE(1), posn27))
         ~raises "not a number"
  check: interp_posn(getE(intE(1), #'x))
         ~raises "not an object"
  check: interp_posn(sendE(intE(1), #'mdist, intE(0)))
         ~raises "not an object"
  check: interp_posn(newE(#'Posn, [intE(0)]))
         ~raises "wrong field count"
// 3.
module test:
  check: interp(ifzeroE(intE(0),
                        intE(1),
                        intE(2)),
                [],
                objV(#'Object, []),
                intV(0), [])
         ~is intV(1)

  check: interp(ifzeroE(intE(1),
                        intE(1),
                        intE(2)),
                [],
                objV(#'Object, []),
                intV(0), [])
         ~is intV(2)

  check: interp(ifzeroE(thisE(),
                        intE(1), 
                        intE(2)),
                [],
                objV(#'Object, []),
                intV(0), [])
         ~raises "condition must be number"
  check: interp(letE(#'x, intE(5), 
                     plusE(idE(#'x), intE(1))),
                [], objV(#'Object, []), intV(0), [])
         ~is intV(6)
  check: interp(letE(#'x, intE(10),
                     letE(#'y, intE(20),
                          plusE(idE(#'x), idE(#'y)))),
                [], objV(#'Object, []), intV(0), [])
         ~is intV(30)
  check: interp(letE(#'x, intE(5),
                     letE(#'y, idE(#'x),
                          plusE(idE(#'x), idE(#'y)))),
                [], objV(#'Object, []), intV(0), [])
         ~is intV(10)
  check: interp(idE(#'x),
                [], objV(#'Object, []), intV(0), [])
         ~raises "unbound identifier: x"
  check: interp(letE(#'x, intE(1),
                     letE(#'x, intE(2),
                          idE(#'x))),
                [], objV(#'Object, []), intV(0), [])
         ~is intV(2)
  check: interp(letE(#'x, intE(5),
                     multE(idE(#'x), 
                           plusE(idE(#'x), intE(1)))),
                [], objV(#'Object, []), intV(0), [])
         ~is intV(30)
  // 8.
  def null_returning_class:
    values(#'NullTest,
           classC([],
                  [values(#'getNullObj,
                          nullE()),
                   values(#'useNullArg,
                          intE(42)),
                   values(#'nullFieldAccess,
                          getE(nullE(), #'someField)),
                   values(#'nullMethodCall,
                          sendE(nullE(), #'someMethod, intE(0)))]))
  check: interp(nullE(),
                [null_returning_class],
                objV(#'Object, []),
                intV(0),
                [])
         ~is nullV()
  check: interp(castE(#'Posn, nullE()),
                [posn_class],
                objV(#'Object, []),
                intV(0),
                [])
         ~is nullV()
  check: interp(castE(#'Posn3D, nullE()),
                [posn_class, posn3D_class],
                objV(#'Object, []),
                intV(0),
                [])
         ~is nullV()
  check: interp(castE(#'Posn, intE(42)),
                [posn_class],
                objV(#'Object, []),
                intV(0),
                [])
         ~raises "can only cast objects"
  check: interp(castE(#'Posn, posn27),
                [posn_class],
                objV(#'Object, []),
                intV(0),
                [])
         ~is objV(#'Posn, [intV(2), intV(7)])
// 1.
module test:
  def another_class:
    values(#'AnotherClass,
           classC([],
                  [values(#'dummy, intE(0))]))
  check: interp(castE(#'AnotherClass, posn27),
                [posn_class, another_class],
                objV(#'Object, []),
                intV(0),
                [])
         ~raises "cast failed: Posn is not a AnotherClass"
  check: member(#'x, [#'y, #'x])
         ~is #true
  check: subset([#'x, #'y], [#'x, #'y, #'z])
         ~is #true
  check: check_class_ancestor(#'NonExistClass, #'Object, [])
         ~is #false

