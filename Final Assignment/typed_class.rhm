// 4.
module test:
  def posn_t_class:
    values(#'Posn,
           classT(#'Object,
                  [values(#'x, intT()), values(#'y, intT())],
                  [values(#'mdist,
                          methodT(intT(), intT(),
                                  plusI(getI(thisI(), #'x), 
                                        getI(thisI(), #'y)),
                                  #false)), // public
                   values(#'addDist,
                          methodT(objT(#'Posn), intT(),
                                  plusI(sendI(thisI(), #'mdist, intI(0)),
                                        sendI(argI(), #'mdist, intI(0))),
                                  #false))]))  // public

  def posn3D_t_class:
    values(#'Posn3D,
           classT(#'Posn,
                  [values(#'z, intT())],
                  [values(#'mdist,
                          methodT(intT(), intT(),
                                  plusI(getI(thisI(), #'z),
                                        superI(#'mdist, argI())),
                                  #false))]))

  def square_t_class :
    values(#'Square,
           classT(#'Object,
                  [values(#'topleft, objT(#'Posn))],
                  []))

  fun typecheck_posn(a):
    typecheck(a, [posn_t_class, posn3D_t_class, square_t_class])
  
  def new_posn27 = newI(#'Posn, [intI(2), intI(7)])
  def new_posn531 = newI(#'Posn3D, [intI(5), intI(3), intI(1)])

  check: typecheck_posn(sendI(new_posn27, #'mdist, intI(0)))
         ~is intT()
  check: typecheck_posn(sendI(new_posn531, #'mdist, intI(0)))
         ~is intT()  
  check: typecheck_posn(sendI(new_posn531, #'addDist, new_posn27))
         ~is intT() 
  check: typecheck_posn(sendI(new_posn27, #'addDist, new_posn531))
         ~is intT()

  check: typecheck_posn(newI(#'Square, [newI(#'Posn, [intI(0), intI(1)])]))
         ~is objT(#'Square)
  check: typecheck_posn(newI(#'Square, [newI(#'Posn3D, [intI(0), intI(1), intI(3)])]))
         ~is objT(#'Square)

  check: typecheck(multI(intI(1), intI(2)),
                   [])
         ~is intT()

  check: typecheck_posn(sendI(intI(10), #'mdist, intI(0)))
         ~raises "no type"
  check: typecheck_posn(sendI(new_posn27, #'mdist, new_posn27))
         ~raises "no type"
  check: typecheck(plusI(intI(1), newI(#'Object, [])),
                   [])
         ~raises "no type"
  check: typecheck(plusI(newI(#'Object, []), intI(1)),
                   [])
         ~raises "no type"
  check: typecheck(plusI(intI(1), newI(#'Object, [intI(1)])),
                   [])
         ~raises "no type"
  check: typecheck(getI(intI(1), #'x),
                   [])
         ~raises "no type"
  check: typecheck(intI(10),
                   [posn_t_class,
                    values(#'Other,
                           classT(#'Posn,
                                  [],
                                  [values(#'mdist,
                                          methodT(objT(#'Object), intT(),
                                                  intI(10),
                                                  #false))]))])
         ~raises "bad override"
  check: typecheck_method(methodT(intT(), objT(#'Object), intI(0), #false), objT(#'Object), [])
         ~raises "no type"
  check: typecheck(intI(0),
                   [square_t_class,
                    values(#'Cube,
                           classT(#'Square,
                                  [],
                                  [values(#'m,
                                          methodT(intT(), intT(),
                                                  // No such method in superclass:
                                                  superI(#'m, intI(0)), #false))]))])
         ~raises "not found"
  // 3.
  check: typecheck(ifzeroI(intI(0),
                           newI(#'Posn3D, [intI(1), intI(2), intI(3)]),
                           newI(#'Posn, [intI(1), intI(2)])),
                   [posn_t_class, posn3D_t_class])
         ~is objT(#'Posn)
         
  check: typecheck(ifzeroI(intI(0),
                           newI(#'Posn3D, [intI(1), intI(2), intI(3)]),
                           newI(#'Posn3D, [intI(4), intI(5), intI(6)])),
                   [posn_t_class, posn3D_t_class])
         ~is objT(#'Posn3D)

  check: typecheck(ifzeroI(intI(0),
                           newI(#'Posn, [intI(1), intI(2)]),
                           newI(#'Posn3D, [intI(1), intI(2), intI(3)])),
                   [posn_t_class, posn3D_t_class])
         ~is objT(#'Posn)

  check: typecheck(ifzeroI(thisI(),
                           intI(1),
                           intI(2)),
                   [posn_t_class, posn3D_t_class])
         ~raises "typecheck: no type: thisI() not Int"

  check: typecheck(ifzeroI(intI(0),
                           intI(1),
                           newI(#'Posn, [intI(1), intI(2)])),
                   [posn_t_class, posn3D_t_class])
         ~raises "typecheck: no type: ifzeroI(intI(0), intI(1), newI(#'Posn, [intI(1), intI(2)])) not no common supertype"

// ----------------------------------------

def strip_types :: ClassT -> ClassI:
  fun (t_class):
    match t_class
    | classT(super_name, fields, methods):
       classI(super_name,
              map(fst, fields),
              map(fun (m):
                    values(fst(m),
                           match snd(m)
                           | methodT(arg_type, result_type, body_exp, private):
                               body_exp),
                  methods))

def interp_t :: (ExpI, Listof(Symbol * ClassT)) -> Value:
  fun (a, t_classes):
    interp_i(a,
             map(fun (c):
                   values(fst(c), strip_types(snd(c))),
                 t_classes))

module test:
  fun interp_t_posn(a):
    interp_t(a, [posn_t_class, posn3D_t_class])
  
  check: interp_t_posn(sendI(new_posn27, #'mdist, intI(0)))
         ~is intV(9)
  check: interp_t_posn(sendI(new_posn531, #'mdist, intI(0)))
         ~is intV(9)
  check: interp_t_posn(sendI(new_posn531, #'addDist, new_posn27))
         ~is intV(18)
  check: interp_t_posn(sendI(new_posn27, #'addDist, new_posn531))
         ~is intV(18)

// 4.
module test:
  def private_test_classes = [
    values(#'Object,
           classT(#'Object, 
                  [], 
                  [])),
    values(#'A,
           classT(#'Object,
                  [], 
                  [values(#'secret,
                          methodT(intT(), intT(),
                                  plusI(argI(), intI(1)),
                                  #true)),  // private
                   values(#'public,
                          methodT(intT(), intT(),
                                  sendI(thisI(), #'secret, argI()),
                                  #false)),  // public
                   values(#'alwaysAvailable,
                          methodT(intT(), intT(),
                                  intI(1),
                                  #false))])), // public
    values(#'B,
           classT(#'A,
                  [],
                  [values(#'secret,
                          methodT(intT(), intT(),
                                  plusI(argI(), intI(2)),
                                  #true))]))  // private
  ]
  check: typecheck(sendI(newI(#'A, []), #'public, intI(5)),
                   private_test_classes)
         ~is intT()

  check: typecheck(sendI(newI(#'A, []), #'secret, intI(5)),
                   private_test_classes)
         ~raises "private method"

  check: typecheck(sendI(newI(#'B, []), #'public, intI(5)),
                   private_test_classes)
         ~is intT()
  check: typecheck(sendI(newI(#'A, []), #'secret, newI(#'Object, [])),
                   private_test_classes)
         ~raises "no type: objT(#'Object) not intT()"
  check: typecheck(sendI(intI(42), #'secret, intI(5)),
                   private_test_classes)
         ~raises "no type: intI(42) not object"
  check: typecheck_send(#'A,
                        #'alwaysAvailable,
                        intT(),
                        intT(),
                        private_test_classes)
         ~raises "no type: intT() not object"
// 5.
module test:
  check: typecheck_exp(letI(#'x, intT(), intI(5), 
                            plusI(idI(#'x), intI(1))),
                       [], objT(#'Object), intT(), [])
         ~is intT()
  check: typecheck_exp(letI(#'this, intT(), intI(5), intI(1)),
                       [], objT(#'Object), intT(), [])
         ~raises "cannot use 'this' as variable name"
  check: typecheck_exp(letI(#'x, intT(), 
                            newI(#'Object, []),
                            idI(#'x)),
                       [], objT(#'Object), intT(), [])
         ~raises "not intT()"
  check: typecheck_exp(letI(#'x, intT(), intI(5),
                            idI(#'x)),
                       [], objT(#'Object), intT(), [])
         ~is intT()
  check: typecheck_exp(idI(#'x),
                       [], objT(#'Object), intT(), [])
         ~raises "unbound identifier: x"
  check: typecheck_exp(letI(#'x, intT(), intI(5),
                            letI(#'y, intT(), intI(3),
                                 plusI(idI(#'x), idI(#'y)))),
                       [], objT(#'Object), intT(), [])
         ~is intT()
  check: typecheck_exp(letI(#'x, intT(), intI(5),
                            letI(#'y, intT(), idI(#'x),
                                 plusI(idI(#'x), idI(#'y)))),
                       [], objT(#'Object), intT(), [])
         ~is intT()
// 6.
module test:

  def field_t_class = values(#'A,
                             classT(#'Object,
                                    [values(#'x, intT())],
                                    []))
  check: typecheck_exp(fieldI(#'x),
                       [a_t_class],
                       objT(#'A),
                       intT(),
                       [values(#'x, objT(#'Object))])
         ~is objT(#'Object)
  check: typecheck_exp(fieldI(#'x),
                       [a_t_class],
                       intT(),
                       intT(),
                       [])
         ~raises "can't access fields outside of class"
  check: typecheck_exp(fieldI(#'x),
                       [field_t_class],
                       objT(#'A),
                       intT(),
                       [])
         ~is intT()
module test:
  // Test null method call type checking
  check: typecheck_send(#'Object,  // class_name 
                        #'someMethod,  // method_name
                        nullT(),  // caller_type
                        intT(),  // arg_type 
                        [])  // t_classes
         ~raises "null value cannot call methods"
  // Test calling super on null
  check: typecheck_exp(superI(#'method, argI()), 
                       [],  // t_classes
                       nullT(),  // this_type
                       intT(),  // arg_type
                       [])  // env
         ~raises "cannot use super on null"
  check: typecheck_exp(superI(#'method, argI()),
                       [], 
                       intT(),
                       intT(), 
                       [])
         ~raises "can't use super outside of class"
  def test_class = values(#'TestClass,
                          classT(#'Object,
                                 [values(#'x, intT())],
                                 [values(#'m, methodT(intT(), intT(), argI(), #false))]))

  // getI --------------------------------
  check: typecheck_exp(getI(nullI(), #'x),
                       [test_class],
                       objT(#'Object),
                       intT(),
                       [])
         ~raises "cannot access field of null"
  // sendI --------------------------------
  check: typecheck_exp(sendI(nullI(), #'m, intI(0)),
                       [test_class],
                       objT(#'Object),
                       intT(),
                       [])
         ~raises "cannot call method on null"
  check: typecheck_exp(fieldI(#'x),
                       [],
                       nullT(),
                       intT(),
                       [])
         ~raises "cannot access field of null"
  check: is_subtype(nullT(),
                    objT(#'Object),
                    [])
         ~is #true
  check: is_subtype(nullT(),
                    intT(),
                    [])
         ~is #false
// 1.
module test:
  def point_t_class = values(#'Point,
                             classT(#'Object,
                                    [values(#'x, intT()),
                                     values(#'y, intT())],
                                    []))                      
  def point3d_t_class = values(#'Point3D,
                               classT(#'Point,
                                      [values(#'z, intT())],
                                      []))
  def circle_t_class = values(#'Circle,
                              classT(#'Object,
                                     [values(#'radius, intT())],
                                     []))
  check: typecheck(castI(#'Point, newI(#'Point3D, [intI(1), intI(2), intI(3)])),
                   [point_t_class, point3d_t_class])
         ~is objT(#'Point)
  check: typecheck(castI(#'Point3D, newI(#'Point, [intI(1), intI(2)])),
                   [point_t_class, point3d_t_class])
         ~is objT(#'Point3D)
  check: typecheck(castI(#'Circle, newI(#'Point, [intI(1), intI(2)])),
                   [point_t_class, circle_t_class])
         ~raises "cast cannot succeed between unrelated types"
  check: typecheck(castI(#'Point, nullI()),
                   [point_t_class])
         ~is objT(#'Point)
  check: typecheck(castI(#'Point, intI(42)),
                   [point_t_class])
         ~raises "can only cast object types"