#lang shplait

// Add `letq`
//   letq 20 * 10:
//     q + 1
//   => 201

// Add `letz`, but as sugar over `let:
//  letz 20 * 10:
//     z + 1
// =>
//  let z = 20 * 10:
//     z + 1

type Exp
| intE(n :: Int)
| idE(s :: Symbol)
| plusE(l :: Exp,
        r :: Exp)
| multE(l :: Exp,
        r :: Exp)
| appE(s :: Symbol,
       arg :: Exp)
| letE(n :: Symbol,
       rhs :: Exp,
       body :: Exp)
| letqE(rhs :: Exp,
        body :: Exp)

type FunDef
| fd(name :: Symbol,
     arg :: Symbol,
     body :: Exp)

type Binding
| bind(name :: Symbol,
       val :: Int)

type Env = Listof(Binding)

def mt_env = []
def extend_env = cons

fun parse(s :: Syntax) :: Exp:
  cond
  | syntax_is_integer(s):
      intE(syntax_to_integer(s))
  | syntax_is_symbol(s):
      idE(syntax_to_symbol(s))
  | ~else:
      match s
      | 'let $name = $rhs:
           $body':
          letE(syntax_to_symbol(name),
               parse(rhs),
               parse(body))
      | 'letq $exp:
           $body':
          letqE(parse(exp), parse(body))
      | 'letz $exp:
           $body':
          // sugar for `let`:
          letE(#'z,
               parse(exp),
               parse(body))
          // another approach:
          #//
          parse('let z = $exp:
                   $body')
      | '$left + $right':
          plusE(parse(left),
                parse(right))
      | '$left * $right':
          multE(parse(left),
                parse(right))
      | '$sym($arg)':
          appE(syntax_to_symbol(sym),
               parse(arg))
      | '($e)':
          parse(e)
      | ~else:
          error(#'parse, "invalid input: " +& s)

fun parse_fundef(s :: Syntax) :: FunDef:
  match s
  | 'fun $name($arg): $body':
      fd(syntax_to_symbol(name),
         syntax_to_symbol(arg),
         parse(body))
  | ~else:
      error(#'parse, "invalid input: " +& s)

module test:
  check: parse('2')
         ~is intE(2)
  check: parse('x')
         ~is idE(#'x)
  check: parse('2 + 1')
         ~is plusE(intE(2), intE (1))
  check: parse('3 * 4')
         ~is multE(intE(3), intE(4))
  check: parse('3 * 4 + 8')
         ~is plusE(multE(intE(3), intE(4)),
                   intE(8))
  check: parse('double(9)')
         ~is appE(#'double, intE(9))
  check: parse('1 + double(9)')
         ~is plusE(intE(1),
                   appE(#'double, intE(9)))
  check: parse('3 * (4 + 8)')
         ~is multE(intE(3),
                   plusE(intE(4), intE(8)))
  check: parse('let x = 1 + 2:
                  y')
         ~is letE(#'x,
                  plusE(intE(1), intE(2)),
                  idE(#'y))
  check: parse('letq 2 * 2 : q')
         ~is letqE(multE(intE(2), intE(2)), idE(#'q))
  check: parse('letz 2 * 2 : q')
         ~is letE(#'z, multE(intE(2), intE(2)), idE(#'q))
  check: parse('1 2')
         ~raises "invalid input"

  check: parse_fundef('fun double(x): x + x')
         ~is fd(#'double, #'x, plusE(idE(#'x), idE(#'x)))
  check: parse_fundef('fun f(): 1')
         ~raises "invalid input"

  def double_def = parse_fundef('fun double(x): x + x')
  def quadruple_def = parse_fundef('fun quadruple(x): double(double(x))')

// interp ----------------------------------------
fun interp(a :: Exp, env :: Env, defs :: Listof(FunDef)) :: Int:
  match a
  | intE(n): n
  | idE(s): lookup(s, env)
  | plusE(l, r): interp(l, env, defs) + interp(r, env, defs)
  | multE(l, r): interp(l, env, defs) * interp(r, env, defs)
  | appE(s, arg):
      block:
        def a_def = get_fundef(s, defs)
        interp(fd.body(a_def),
               extend_env(bind(fd.arg(a_def),
                               interp(arg, env, defs)),
                          mt_env),
               defs)
  | letE(n, rhs, body):
      interp(body,
             extend_env(bind(n, interp(rhs, env, defs)),
                        env),
             defs)
  | letqE(exp, body):
      def v = interp(exp, env, defs)
      interp(body,
             extend_env(bind(#'q, v),
                        env),
             defs)
        
module test:
  check: interp(parse('letq 2 * 3 : q + 1'), mt_env, [])
         ~is 7
  check: interp(parse('2'), mt_env, [])
         ~is 2
  check: interp(parse('x'), mt_env, [])
         ~raises "free variable"
  check: interp(parse('x'),
                extend_env(bind(#'x, 9), mt_env),
                [])
         ~is 9
  check: interp(parse('2 + 1'), mt_env, [])
         ~is 3
  check: interp(parse('2 * 1'), mt_env, [])
         ~is 2
  check: interp(parse('(2 * 3) + (5 + 8)'), mt_env, [])
         ~is 19
  check: interp(parse('double(8)'),
                mt_env,
                [double_def])
         ~is 16
  check: interp(parse('quadruple(8)'),
                mt_env,
                [double_def, quadruple_def])
         ~is 32
  check: interp(parse('let x = 5: x + x'),
                mt_env,
                [])
         ~is 10
  check: interp(parse('let x = 5:
                         let x = x + 1:
                           x + x'),
                mt_env,
                [])
         ~is 12
  check: interp(parse('let x = 5:
                         let y = 6:
                           x'),
                mt_env,
                [])
         ~is 5
  check: interp(parse('let y = 5:
                         bad(2)'),
                mt_env,
                [parse_fundef('fun bad(x): x + y')])
         ~raises "free variable"

// get_fundef ----------------------------------------
fun get_fundef(s :: Symbol, defs :: Listof(FunDef)) :: FunDef:
  match defs
  | []: error(#'get_fundef, "undefined function: " +& s)
  | cons(a_def, rst_defs):
      if s == fd.name(a_def)
      | a_def
      | get_fundef(s, rst_defs)

module test:
  check: get_fundef(#'double, [double_def])
         ~is double_def
  check: get_fundef(#'double, [double_def, quadruple_def])
         ~is double_def
  check: get_fundef(#'double, [quadruple_def, double_def])
         ~is double_def
  check: get_fundef(#'quadruple, [quadruple_def, double_def])
         ~is quadruple_def
  check: get_fundef(#'double, [])
         ~raises "undefined function"

// lookup ----------------------------------------
fun lookup(n :: Symbol, env :: Env) :: Int:
  match env
  | []: error(#'lookup, "free variable: " +& n)
  | cons(b, rst_env):
      cond
      | n == bind.name(b):
          bind.val(b)
      | ~else:
          lookup(n, rst_env)

module test:
  check: lookup(#'x, mt_env)
         ~raises "free variable"
  check: lookup(#'x, extend_env(bind(#'x, 8), mt_env))
         ~is 8
  check: lookup(#'x, extend_env(bind(#'x, 9),
                                extend_env(bind(#'x, 8),
                                           mt_env)))
         ~is 9
  check: lookup(#'y, extend_env(bind(#'x, 9),
                                extend_env(bind(#'y, 8),
                                           mt_env)))
         ~is 8
